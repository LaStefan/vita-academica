rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User uploads (PDFs, CVs, DOCX etc.)
    match /user_uploads/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Parsed document output (optional)
    match /parsed_documents/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public assets (if needed)
    match /public_assets/{assetName} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}